    cmp,test,jmp,je,jne,jz,jnz,jl,jle,jg,jge,ja,jb,call,ret,push,pop,pusha,popa,pushad,popad,
    pushf,popf,pushfd,popfd,lea,int,iret,iretd,hlt,cli,sti,in,out,lgdt,lidt,ltr,lodsb,stosb,
    rep,xchg,nop,invlpg,loop},
  morekeywords=[2]{eax,ebx,ecx,edx,esi,edi,ebp,esp,ax,bx,cx,dx,al,ah,bl,bh,cl,ch,dl,dh,si,di,sp,
    bp,cs,ds,es,fs,gs,ss,cr0,cr2,cr3,cr4,byte,word,dword},
  morekeywords=[3]{section,global,extern,equ,db,dw,dd,dq,resb,resw,resd,align,bits,times,org,
