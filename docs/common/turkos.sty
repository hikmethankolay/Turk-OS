% ---------------------------------------------------------------- chips
% \tkchip[text colour]{fill colour}{label}
\newcommand{\tkchip}[3][white]{%
  \tikz[baseline=(chip.base)]\node[fill=#2, text=#1, rounded corners=1.6pt, inner xsep=2.6pt,
    inner ysep=1.3pt, text height=1.5ex, text depth=.35ex, font=\sffamily\bfseries\scriptsize](chip){#3};}
\newcommand{\LOB}{\tkchip{bkLOB}{LOB}\xspace}
\newcommand{\OSTEP}{\tkchip{bkOSTEP}{OSTEP}\xspace}
\newcommand{\OSC}{\tkchip{bkOSC}{OSC}\xspace}
\newcommand{\MOS}{\tkchip{bkMOS}{MOS}\xspace}
\newcommand{\OSDI}{\tkchip{bkOSDI}{OSDI}\xspace}
\newcommand{\XVSIX}{\tkchip{bkXV}{XV6}\xspace}
\newcommand{\RVSPEC}{\tkchip{bkRV}{RISCV}\xspace}
\newcommand{\ARMDOC}{\tkchip{bkARM}{ARM}\xspace}
\newcommand{\SPEC}{\tkchip{bkSPEC}{SPEC}\xspace}
\newcommand{\must}{\tkchip{tkRed}{REQUIRED}\xspace}
\newcommand{\should}{\tkchip{tkAmber}{RECOMMENDED}\xspace}
\newcommand{\could}{\tkchip[tkGray]{tkGray!15}{OPTIONAL}\xspace}

% ---------------------------------------------------------------- title banner
% \phaseheader{number}{title}{subtitle}{progress from}{progress to}
\newcommand{\phaseheader}[5]{%
  \renewcommand{\phasenum}{#1}\renewcommand{\phasetitle}{#2}%
  \renewcommand{\headlabel}{Phase #1 \textperiodcentered\ #2}%
  \hypersetup{pdftitle={Turk-OS Phase #1: #2}, pdfauthor={Turk-OS Study Plan}}%
  \thispagestyle{plain}%
  \noindent\begin{tikzpicture}
    \path[use as bounding box] (0,0) rectangle (\linewidth,3.3cm);
    \fill[tkNavy, rounded corners=5pt] (0,0) rectangle (\linewidth,3.3cm);
    \fill[tkRed, rounded corners=5pt] (0,0) rectangle (0.2\linewidth,3.3cm);
    \fill[tkRed] (0.15\linewidth,0) rectangle (0.2\linewidth,3.3cm);
    \node[font=\sffamily\bfseries\footnotesize, text=white, anchor=north] at (0.1\linewidth,3.0cm) {PHASE};
    \node[font=\sffamily\bfseries\fontsize{42}{42}\selectfont, text=white] at (0.1\linewidth,1.45cm) {#1};
    \node[font=\sffamily\bfseries\LARGE, text=white, anchor=north west, text width=0.74\linewidth, align=left, execute at begin node={\hyphenpenalty=10000\exhyphenpenalty=10000\relax}] at (0.23\linewidth,2.95cm) {#2};
    \node[font=\sffamily\small, text=white!78!tkNavy, anchor=south west, text width=0.74\linewidth, align=left] at (0.23\linewidth,0.35cm) {#3};
  \end{tikzpicture}\par\vspace{0.3em}%
  \noindent\tkprogress{#4}{#5}\par\vspace{0.2em}%
}

% \tkprogress{from}{to} -- overall progress bar, this phase highlighted in red.
% Stage V documents (Phases 16-18) measure toward Turk-OS 2.0 instead: put
% \renewcommand{\progresslabel}{...} before \phaseheader.
\newcommand{\progresslabel}{Overall progress toward Turk-OS 1.0 (this phase in red)}
\newcommand{\tkprogress}[2]{%
  \begin{tikzpicture}
    \path[use as bounding box] (0cm,-0.45cm) rectangle (\linewidth,0.25cm);
    \fill[tkGray!18, rounded corners=1.5pt] (0cm,0cm) rectangle (\linewidth,0.22cm);
    \ifdim #1pt>0pt \fill[tkNavy!65, rounded corners=1.5pt] (0cm,0cm) rectangle ({#1/100*\linewidth},0.22cm);\fi
    \fill[tkRed] ({#1/100*\linewidth},0cm) rectangle ({#2/100*\linewidth},0.22cm);
    \node[font=\sffamily\scriptsize, text=tkGray, anchor=north west, inner sep=0pt] at (0cm,-0.12cm) {\progresslabel};
    \node[font=\sffamily\scriptsize\bfseries, text=tkRed, anchor=north east, inner sep=0pt] at (\linewidth,-0.12cm) {#1\,\% $\rightarrow$ #2\,\%};
  \end{tikzpicture}}

\newcommand{\tkstars}[1]{%
  \foreach \s in {1,...,5}{\ifnum\s>#1\relax\textcolor{tkGray!45}{\faStar[regular]}\else\textcolor{tkRed}{\faStar}\fi\,}%
  \enspace\textcolor{tkGray}{\footnotesize(#1/5)}}

% \ataglance{duration}{difficulty 1-5}{prerequisites}{outcome}
\newcommand{\ataglance}[4]{%
  \begin{tcolorbox}[enhanced, colback=tkLight, colframe=tkNavy!20, boxrule=0.5pt, arc=2pt,
      left=8pt, right=8pt, top=4pt, bottom=4pt, before skip=6pt, after skip=10pt]
  \small\renewcommand{\arraystretch}{1.3}%
  \begin{tabularx}{\linewidth}{@{}>{\leavevmode\sffamily\bfseries\color{tkNavy}}p{0.21\linewidth} X@{}}
    \faClock[regular]\enspace Duration & #1 \\
    \faStar\enspace Difficulty & \tkstars{#2} \\
    \faTools\enspace You need & #3 \\
    \faRocket\enspace You will have & #4 \\
  \end{tabularx}
  \end{tcolorbox}}

